APP_NAME="Artisan PM"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# pgsql, mysql (MySQL 8+ / MariaDB 10.x) and sqlite are supported. On shared
# hosting that only offers MySQL/MariaDB, use e.g.:
#   DB_CONNECTION=mysql
#   DB_HOST=localhost   (or the host name your host gives you)
#   DB_PORT=3306
DB_CONNECTION=pgsql
DB_HOST=pgsql
DB_PORT=5432
DB_DATABASE=laravel
DB_USERNAME=sail
DB_PASSWORD=password

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

# Scheduled jobs (incoming mail, repository autofetch, housekeeping) run inside
# `schedule:run` itself, so no queue worker is needed for them. Set a real
# connection (e.g. database) to hand them to `queue:work` instead.
# SCHEDULER_QUEUE_CONNECTION=sync

CACHE_STORE=database
# CACHE_PREFIX=

SCOUT_DRIVER=database

# Shared hosting without a resident process (no Supervisor/systemd, no Redis):
#   - one cron entry runs the scheduler:
#       * * * * * cd /path/to/app && php artisan schedule:run >> /dev/null 2>&1
#   - notification mails, webhooks and imports are queued. Either send them
#     inline with QUEUE_CONNECTION=sync, or drain the database queue from cron
#     (a second entry, up to ~1 minute of delay):
#       * * * * * cd /path/to/app && php artisan queue:work --queue=default,webhooks --stop-when-empty --max-time=55 --tries=1
#   - keep QUEUE/CACHE/SESSION on database (or file); Redis is not required.
#   - public/build is not committed: run `npm run build` locally and upload it.

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Incoming mail (issue creation from email) — leave IMAP_HOST empty to
# disable polling regardless of the incoming_mail_enabled setting.
IMAP_HOST=
IMAP_PORT=993
IMAP_ENCRYPTION=ssl
IMAP_USERNAME=
IMAP_PASSWORD=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
