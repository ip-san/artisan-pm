APP_NAME="Artisan PM"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# HTTPS behind a proxy: many hosts (Xserver, さくら, ConoHa WING, a CDN or a
# load balancer) terminate TLS in front of PHP and pass the request on as
# plain HTTP with X-Forwarded-Proto: https. Trust that proxy so the app
# builds https:// links and redirects (and secure cookies work). `*` trusts
# any proxy — fine when PHP can only be reached through the host's proxy;
# otherwise list the proxy IPs/CIDR ranges, comma-separated. Leave empty
# when PHP is reached directly. Also set APP_URL to the https:// address.
# TRUSTED_PROXIES=*

APP_LOCALE=ja
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Supported databases: PostgreSQL, MySQL 8.0+, MariaDB 10.3+ (tested with
# 10.11) and SQLite. MySQL 5.7 is NOT supported (no recursive CTEs, which
# the issue tree queries need). On shared hosting that only offers
# MySQL/MariaDB, use e.g.:
#   DB_CONNECTION=mysql      (or mariadb for a MariaDB server)
#   DB_HOST=localhost        (or the host name your host gives you)
#   DB_PORT=3306
#   DB_CHARSET=utf8mb4
#   DB_COLLATION=utf8mb4_0900_as_ci    (MySQL 8)
#   DB_COLLATION=utf8mb4_uca1400_as_ci (MariaDB 10.10+)
# The default collation utf8mb4_unicode_ci treats は/ば/ぱ, and even many
# emoji (🍣 and 🍺), as the same character in searches and unique names. The
# accent-sensitive, case-insensitive collations above keep voiced marks and
# emoji apart while still ignoring upper/lower case (like PostgreSQL's
# ILIKE here); they still match hiragana with katakana and full-width with
# half-width letters. On MariaDB before 10.10 use utf8mb4_unicode_520_ci
# (still conflates は/ぱ) or utf8mb4_bin (exact, but case-sensitive).
# Choose the collation before the first `php artisan migrate`: tables keep
# the collation they were created with.
DB_CONNECTION=pgsql
DB_HOST=pgsql
DB_PORT=5432
DB_DATABASE=laravel
DB_USERNAME=sail
DB_PASSWORD=password

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

# Scheduled jobs (incoming mail, repository autofetch, housekeeping) run inside
# `schedule:run` itself, so no queue worker is needed for them. Set a real
# connection (e.g. database) to hand them to `queue:work` instead.
# SCHEDULER_QUEUE_CONNECTION=sync

CACHE_STORE=database
# CACHE_PREFIX=

SCOUT_DRIVER=database

# Shared hosting without a resident process (no Supervisor/systemd, no Redis)
# — see also "Deploying to shared hosting" in README.md:
#   - one cron entry runs the scheduler, every minute if the host allows it:
#       * * * * * cd /path/to/app && php artisan schedule:run >> /dev/null 2>&1
#     schedule:run only starts the events that are due in the minute it runs
#     in; it does not catch up on missed ones. With a 5-minute cron
#     (*/5 * * * *, the shortest interval on some control panels) the
#     5/15-minute and hourly jobs still run, as long as the cron fires at
#     :00, :05, :10 … (the minute has to be a multiple of 5 — a cron started
#     at :03 every 5 minutes would never hit :00, and the hourly and daily
#     jobs would never run). Intervals longer than 5 minutes, or a cron that
#     the host delays past the minute, skip the jobs due in between: the
#     every-5-minutes incoming mail and the daily housekeeping run late or
#     not at all. Use `* * * * *` when you can.
#   - notification mails, webhooks and CSV imports are queued. Keep
#     QUEUE_CONNECTION=database (recommended): the same schedule:run cron line
#     then also works off the queue (queue:work --stop-when-empty
#     --max-time=50, never two at once), so no second cron entry and no
#     resident worker are needed, and a long import runs in the cron's CLI
#     process instead of a web request limited by max_execution_time. Jobs
#     wait until the next cron run (up to the cron interval). Their $timeout
#     is only enforced when the pcntl extension is available.
#     QUEUE_CONNECTION=sync also works (everything runs inside the web
#     request), but a large import or many notification mails can then hit
#     max_execution_time.
#   - keep QUEUE/CACHE/SESSION on database (or file); Redis is not required.
#   - public/build is not committed: run `npm run build` locally and upload it.
#   - PHP: 8.3 or later, for both the site and the cron line (the cron's
#     plain `php` is often an older version; hosts provide versioned
#     binaries such as /usr/bin/php8.3 — use its full path).
#     Required PHP extensions: pdo_mysql (or pdo_pgsql / pdo_sqlite for the
#     database you use), mbstring, intl (number formatting), openssl, sodium,
#     fileinfo, exif, dom, libxml, iconv, zip, zlib, ctype, filter, tokenizer,
#     session, simplexml, and gd (thumbnails, Gantt PNG). ldap only
#     for LDAP (below). pcntl is optional (job timeouts). proc_open is
#     needed only for Git/SVN repositories (without it the repository pages
#     show an error message).
#   - LDAP auth (directorytree/ldaprecord-laravel) needs the ldap PHP
#     extension, which composer.lock lists as a hard requirement even if you
#     don't use LDAP. If your host doesn't have it enabled, install with
#     `composer install --no-dev --ignore-platform-req=ext-ldap` (or build
#     vendor/ elsewhere and upload it) and leave LDAP auth sources
#     unconfigured — the app itself doesn't require the extension at
#     runtime unless an LDAP auth source is actually set up.

# Time zones: timestamps are stored in UTC (config app.timezone stays UTC on
# purpose; APP_TIMEZONE is not read) and shown in each user's time zone —
# set the default for users under 設定 → 「新規ユーザーの既定の個人設定」 → タイムゾーン
# (e.g. Asia/Tokyo); each user can override it in their profile.
# SCHEDULE_TIMEZONE is the zone the scheduler runs in: the daily jobs
# (unwatching what users can no longer see) run at its midnight. Unset it is
# UTC, i.e. 09:00 in Japan; set Asia/Tokyo to run them at Japanese midnight.
# SCHEDULE_TIMEZONE=Asia/Tokyo

# Where the app looks for Git/SVN repositories: every repository path must be
# inside this directory (default storage/app/private/repositories). Needs
# the git/svn binaries and proc_open on the server.
# SCM_REPOSITORIES_ROOT=/home/you/repositories
# Remote Subversion servers a repository may point at (host names, IPs or
# CIDR ranges, comma-separated). Empty = remote repositories disabled.
# SCM_ALLOWED_HOSTS=svn.example.com

# Plugin folders (<path>/<id>/plugin.json); default plugins/ in the app.
# PLUGINS_PATH=/home/you/artisan-pm-plugins

# Image library for attachment thumbnails: gd (default, available almost
# everywhere) or imagick (if the host has the imagick extension).
# IMAGE_DRIVER=gd
# Image optimizer binaries (jpegoptim, pngquant, optipng …) run on
# thumbnails. Off by default — shared hosts don't have them (or proc_open).
# MEDIA_IMAGE_OPTIMIZERS=true

# Largest Gantt PNG export in pixels (default 12000000, about 60MB while
# drawing — fits a 128MB memory_limit; roughly 180 rows over 24 months).
# A larger chart shows a message instead. Raise only with more memory.
# GANTT_PNG_MAX_PIXELS=12000000

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Incoming mail (issue creation from email) — leave IMAP_HOST empty to
# disable polling regardless of the incoming_mail_enabled setting.
IMAP_HOST=
IMAP_PORT=993
IMAP_ENCRYPTION=ssl
IMAP_USERNAME=
IMAP_PASSWORD=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
