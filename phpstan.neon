includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    paths:
        - app

    level: 6

    excludePaths:
        - app/Providers/*Reverb*

    checkOctaneCompatibility: true
    checkModelProperties: true
    parseModelCastsMethod: true

    ignoreErrors:
        -
            # Only used by Volt single-file components under resources/views,
            # which are outside phpstan's scanned `paths` (Blade files mix
            # PHP with template syntax phpstan can't parse).
            message: '#^Trait App\\Concerns\\InteractsWithQueryFilters is used zero times#'
            path: app/Concerns/InteractsWithQueryFilters.php
        -
            # Same reasoning as InteractsWithQueryFilters above — only used
            # by Volt single-file components under resources/views.
            message: '#^Trait App\\Support\\Auth\\RequiresPasswordConfirmation is used zero times#'
            path: app/Support/Auth/RequiresPasswordConfirmation.php
        -
            # Same reasoning as InteractsWithQueryFilters above — these
            # traits are only used by Volt single-file components.
            identifier: trait.unused
            paths:
                - app/Concerns/ManagesPrincipalMemberships.php
                - app/Concerns/ReordersColumns.php
                - app/Concerns/SelectsPageSize.php
                - app/Concerns/UsesSavedIssueQueriesForFiltering.php
